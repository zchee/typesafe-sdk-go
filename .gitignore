# typesafe-sdk-go project generated files to ignore
#  If you want to ignore files created by your editor/tools,
#  please consider a global .gitignore https://docs.github.com/en/get-started/git-basics/ignoring-files.
#  PLEASE DO NOT open a pull request to add something created by your editor or tools

# github/gitignore/Go
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Editor/IDE
# .idea/
# .vscode/

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a

# Folders
_obj
_test

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

# cgo generated
*.cgo1.go
*.cgo2.c
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*

# test generated
_testmain.go

# benchmark
old.txt
new.txt
bench.txt

# profile
*.pprof

# typesafe-sdk-python at the pinned commit: the ci.yaml lint job checks it out
# here for .github/scripts/port-test-matrix.py --upstream upstream.
/upstream/

# Python caches and coverage data from .github/scripts tests
__pycache__/
.pytest_cache/
.coverage
